# Local server
PORT=8787
REQUEST_TIMEOUT_MS=30000

# Only enable behind a trusted reverse proxy such as local cloudflared.
# This lets rate limiting use CF-Connecting-IP / X-Forwarded-For.
TRUST_PROXY_HEADERS=0

# Extra browser origins allowed to call the API, comma-separated.
# Same-host frontend requests work without this.
# CORS_ORIGINS=https://meomap.example,https://admin.meomap.example

# Leave blank when frontend and API use the same host.
# For a separate API host, set for example:
# VITE_API_BASE=http://192.168.1.20:8787
