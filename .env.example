# Frontend
VITE_BANK_ACCOUNT_NUMBER=19037246299015
VITE_BANK_NAME=Techcombank
VITE_BANK_ACCOUNT_HOLDER=NGUYEN VAN ANH

VITE_SMS_CONFIRM_API_KEY=aB3dE5fG7hI9jK1lM2nO3pQ4rS5tU6vW7xY8zA0==
```
